# Use a paid RPC (Helius, Triton, QuickNode...). Public RPCs rate-limit hard
# and will make the keeper miss buys.
RPC_URL=https://api.devnet.solana.com

# A SECOND, independent RPC provider (a different company from RPC_URL).
# Used only for the pre-payout check, so one provider's glitch can't cause a
# wrong payout.
VERIFY_RPC_URL=

# Your pump.fun coin's mint address.
MINT=

# The BTL program id (from `anchor keys list` after deploying).
BTL_PROGRAM_ID=

# Keeper hot wallet. Holds only a little SOL for transaction fees; it can
# report buys, settle and pause, but it can never withdraw the pot.
KEEPER_KEYPAIR=./keeper.json

# Admin wallet: init-game, resume, void, lock-config. Keep it offline.
ADMIN_KEYPAIR=~/.config/solana/id.json

# Minimum buy, used only by init-game. After that the keeper reads the live
# value from the chain.
MIN_BUY_SOL=0.2

# How often to poll for new buys (ms) and crank fees into the pot (s).
POLL_MS=1500
FEE_CRANK_EVERY_S=60

# Seconds after the deadline (by chain time) the keeper waits, with polling
# caught up, before starting the payout check.
SETTLE_SAFETY_S=15

# Optional: a Discord or Slack webhook that gets a message whenever the game
# is paused, so you hear about it right away.
ALERT_WEBHOOK_URL=
